{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Draw model profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "adapter",
    "operations",
    "formats",
    "experimental_formats",
    "priority",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "adapter": {
      "const": "openai-images-v1"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "generate",
          "edit"
        ]
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "png",
          "jpeg",
          "gif"
        ]
      }
    },
    "experimental_formats": {
      "type": "array",
      "items": {
        "enum": [
          "png",
          "jpeg",
          "gif"
        ]
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
